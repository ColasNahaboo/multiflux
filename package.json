{
	"name": "threeflux",
	"version": "2.7.1-3f.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "node build-extension.mjs",
		"preview": "vite preview",
		"format": "prettier --write . --ignore-unknown",
		"format:check": "prettier --check . --ignore-unknown",
		"test": "node --test",
		"package": "node build-extension.mjs && npx web-ext build --source-dir=dist --filename=threeflux-$(node -p 'JSON.parse(require(\"fs\").readFileSync(\"manifest.json\",\"utf8\")).version_name').zip"
	},
	"dependencies": {
		"@fluentui/react-icons": "^2.0.332",
		"dayjs": "^1.10.4",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-hotkeys-hook": "^2.4.1",
		"styled-components": "^5.2.3"
	},
	"devDependencies": {
		"@vitejs/plugin-react-swc": "^4.3.1",
		"prettier": "^2.2.1",
		"vite": "^8.1.4"
	}
}
