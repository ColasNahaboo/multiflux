{
	"name": "multiflux",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:firefox": "web-ext run --source-dir=dist-firefox --keep-profile-changes",
		"dev:chromium": "chromium --load-extension=\"$PWD/dist-chrome\"",
		"build": "node build-extension.mjs both",
		"build:firefox": "node build-extension.mjs firefox",
		"build:chrome": "node build-extension.mjs chrome",
		"preview": "vite preview",
		"format": "prettier --write . --ignore-unknown",
		"format:check": "prettier --check . --ignore-unknown",
		"test": "node --test",
		"sign:firefox": "web-ext sign --source-dir=dist-firefox --channel=listed"
	},
	"dependencies": {
		"@fluentui/react-icons": "^2.0.332",
		"dayjs": "^1.10.4",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-hotkeys-hook": "^2.4.1",
		"styled-components": "^5.2.3",
		"webextension-polyfill": "^0.12.0"
	},
	"devDependencies": {
		"@vitejs/plugin-react-swc": "^4.3.1",
		"prettier": "^2.2.1",
		"vite": "^8.1.4",
		"web-ext": "^8.5.0"
	}
}
