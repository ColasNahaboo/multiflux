{
  "manifest_version": 3,
  "name": "Multiflux",
  "description": "Unread badge and optional three-pane reader for your self-hosted Miniflux server.",
  "version": "0.0.2",

  "browser_specific_settings": {
    "gecko": {
      "id": "multiflux@example.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "Multiflux",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js",
    "type": "module"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],

  "optional_host_permissions": [
    "https://*/*"
  ]
}
